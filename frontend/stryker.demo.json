{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.demo-mutation.config.ts"
  },
  "mutate": ["src/mocks/mock-backend.ts"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress"],
  "thresholds": {
    "high": 98,
    "low": 96,
    "break": 95
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 8,
  "timeoutMS": 3000
}
