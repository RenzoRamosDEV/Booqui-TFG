{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.demo-mutation.config.ts"
  },
  "mutate": [
    "src/mocks/mock-backend.ts",
    "src/mocks/demo/adapter.ts",
    "src/mocks/demo/demo-routes.ts",
    "src/mocks/demo/install.ts",
    "src/mocks/demo/seed.ts",
    "src/mocks/demo/storage.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress"],
  "thresholds": {
    "high": 98,
    "low": 96,
    "break": 95
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 10,
  "timeoutMS": 3000
}
