# Copy to infra/.env and set real values. Never commit infra/.env.

# Root password of the MySQL container (used only by MySQL itself and its init scripts).
MYSQL_ROOT_PASSWORD=change-me-root

# Application DB user created on first init; ALL privileges on user, event, booking and payment only.
BOOQI_DB_USER=booqi
# Must not contain a single quote (').
BOOQI_DB_PASSWORD=change-me-app

# Origins the services accept for cross-origin browser calls (comma-separated).
BOOQI_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# Host port that publishes the frontend (and the proxied API).
# Rootless hosts whose net.ipv4.ip_unprivileged_port_start is above 80 must use e.g. 8088.
BOOQI_FRONTEND_PORT=80

# Tag of the booqi/* images built by compose.
BOOQI_TAG=latest
